 		/// </summary>
 		private Queue<ulong> _handles;
 
+		// ZD PDF Takeoff (tools/takeoff-dwg/acadsharp.patch): a block's objects are read only once something uses the block — an
+		// insert, a dimension, a multileader, a style's arrowhead, a layout (AutoCAD 2004 and newer). A drawing full of block
+		// definitions nothing inserts (the JADE masonry drawing: 770,000 of its 1,016,357 objects) is read in a fraction of the
+		// time and memory: the takeoff reads it in the browser, in at most 4 GB.
+		private readonly HashSet<ulong> _zdBlocks = new HashSet<ulong>();
+		private readonly HashSet<ulong> _zdUsed = new HashSet<ulong>();
+		private readonly Dictionary<ulong, (CadBlockRecordTemplate Template, List<ulong> Owned, List<ulong> Pending)> _zdDeferred = new Dictionary<ulong, (CadBlockRecordTemplate, List<ulong>, List<ulong>)>();
+		private List<ulong> _zdCollect;   // while the block table or a block header is read: the handles it names, queued after
+
+		private void zdQueue(ulong value)
+		{
+			if (value != 0 &&
+				!this._builder.TryGetObjectTemplate(value, out CadTemplate _) &&
+				!this._readedObjects.ContainsKey(value))
+			{
+				this._handles.Enqueue(value);
+			}
+		}
+
+		private void zdUse(ulong handle)
+		{
+			if (!this._zdBlocks.Contains(handle) || !this._zdUsed.Add(handle))
+				return;
+			if (!this._zdDeferred.TryGetValue(handle, out var d))
+				return;
+			this._zdDeferred.Remove(handle);
+			foreach (ulong h in d.Owned)
+				d.Template.OwnedObjectsHandlers.Add(h);
+			foreach (ulong h in d.Pending)
+				this.zdQueue(h);
+		}
+
+		private void zdBlockRead(CadBlockRecordTemplate template, string name)
+		{
+			List<ulong> pending = this._zdCollect;
+			this._zdCollect = null;
+			ulong handle = template.CadObject.Handle;
+			bool keep = !this.R2004Plus || this._zdBlocks.Count == 0 || this._zdUsed.Contains(handle)
+				|| (name ?? "").StartsWith("*Model_Space", System.StringComparison.OrdinalIgnoreCase)
+				|| (name ?? "").StartsWith("*Paper_Space", System.StringComparison.OrdinalIgnoreCase);
+			if (keep)
+			{
+				foreach (ulong h in pending)
+					this.zdQueue(h);
+				return;
+			}
+			//the block's own BLOCK / ENDBLK and its layout now; its objects, extension dictionary and the like once it is used
+			HashSet<ulong> now = new HashSet<ulong> { template.BeginBlockHandle ?? 0, template.EndBlockHandle ?? 0, template.LayoutHandle ?? 0 };
+			List<ulong> later = new List<ulong>();
+			foreach (ulong h in pending)
+			{
+				if (now.Contains(h))
+					this.zdQueue(h);
+				else
+					later.Add(h);
+			}
+			List<ulong> owned = new List<ulong>(template.OwnedObjectsHandlers);
+			template.OwnedObjectsHandlers.Clear();
+			this._zdDeferred[handle] = (template, owned, later);
+		}
+
