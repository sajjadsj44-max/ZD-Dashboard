<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- The PDF Takeoff's second DWG reader (ZdDwg.cs) as WebAssembly: built by build.ps1 into takeoff/dwg/, on ACadSharp's own source
       (AcsDir: v3.8.35 with CSUtilities, fetched by build.ps1) with acadsharp.patch — a block's objects read only once it is used -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <WasmEnableWebcil>true</WasmEnableWebcil>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebuggerSupport>false</DebuggerSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- compiled ahead of time (2-3x quicker than the interpreter) and up to 4 GB of memory -->
    <WasmBuildNative>true</WasmBuildNative>
    <RunAOTCompilation>true</RunAOTCompilation>
    <EmccMaximumHeapSize>4294901760</EmccMaximumHeapSize>
    <AcsDir Condition="'$(AcsDir)' == ''">$(MSBuildThisFileDirectory)..\zd-takeoff-dwg-build-acs\ACadSharp-3.8.35</AcsDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(AcsDir)\src\ACadSharp\ACadSharp.csproj" />
    <TrimmerRootAssembly Include="ACadSharp" />
    <Compile Remove="acs/**" /><None Remove="acs/**" />
  </ItemGroup>
</Project>
