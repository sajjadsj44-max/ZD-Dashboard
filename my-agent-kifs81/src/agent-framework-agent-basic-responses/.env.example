# Which model the agent uses: github (free), ollama (free, local) or foundry (Azure, paid).
MODEL_PROVIDER=github

# github: leave blank to reuse your `gh auth login` session, or paste a token
# from https://github.com/settings/tokens (fine-grained, "Models: read").
GITHUB_TOKEN=

# Optional: override the provider's default model (github: openai/gpt-4.1-mini, ollama: llama3.2).
MODEL_NAME=

# foundry only
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=
